{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/vite.svg", "dest": "/vite.svg" },
    { "src": "/api/(.*)", "dest": "https://ai-interviewer-system-8yqs.onrender.com/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}